{
  "name": "fleetguard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx db/seeds/seed.ts",
    "workers": "tsx src/workers/worker-runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-iot-data-plane": "^3.821.0",
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/client-sqs": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.2",
    "fastify": "^4.29.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^2.1.0",
    "ioredis": "^5.5.0",
    "luxon": "^3.6.1",
    "postgres": "^3.4.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/node": "^22.15.29",
    "drizzle-kit": "^0.31.2",
    "tsx": "^4.20.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
